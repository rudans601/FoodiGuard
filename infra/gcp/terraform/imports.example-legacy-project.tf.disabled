# HISTORICAL ONLY: example-legacy-project was deleted. This .disabled file is not loaded
# by Terraform. Do not copy it to .tf when rebuilding example-foodiguard.
# Production inventory from 2026-09-19. These imports adopt existing resources;
# they do not create a parallel cluster, database or alerting stack. The older
# Jenkins resources are already in the migrated state and are not repeated here.
import {
  to = google_storage_bucket.terraform_state
  id = "example-legacy-project-foodiguard-tfstate"
}

import {
  to = google_artifact_registry_repository.docker_repo
  id = "projects/example-legacy-project/locations/asia-northeast3/repositories/foodiguard-api"
}

import {
  to = google_container_cluster.foodiguard
  id = "projects/example-legacy-project/locations/asia-northeast3/clusters/foodiguard-cluster"
}

import {
  to = google_sql_database_instance.postgres[0]
  id = "projects/example-legacy-project/instances/foodiguard-db"
}

import {
  to = google_sql_database.foodiguard[0]
  id = "projects/example-legacy-project/instances/foodiguard-db/databases/foodiguard"
}

import {
  to = google_service_account.foodiguard_api
  id = "projects/example-legacy-project/serviceAccounts/foodiguard-api-sa@example-legacy-project.iam.gserviceaccount.com"
}

import {
  to = google_project_iam_member.foodiguard_api_roles["roles/cloudsql.client"]
  id = "example-legacy-project roles/cloudsql.client serviceAccount:foodiguard-api-sa@example-legacy-project.iam.gserviceaccount.com"
}

import {
  to = google_project_iam_member.foodiguard_api_roles["roles/aiplatform.user"]
  id = "example-legacy-project roles/aiplatform.user serviceAccount:foodiguard-api-sa@example-legacy-project.iam.gserviceaccount.com"
}

import {
